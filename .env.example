GEMINI_API_KEY=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=

# Gmail: enable 2-step verification, then create an App Password at
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Optional, defaults to SMTP_USER
EMAIL_FROM=

# Hosted databases (e.g. Render): set DATABASE_URL instead of POSTGRES_*.
# When set, it takes priority over the POSTGRES_* variables above.
DATABASE_URL=

# Who receives the digest. Set these on the server instead of committing
# your real email address to the repository.
DIGEST_USER_EMAIL=
DIGEST_USER_NAME=
DIGEST_USER_INTERESTS=
